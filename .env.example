# `ma` configuration template. Copy to `.env` and fill in.
#
# `.env` is loaded at startup from the executable's directory, and (in debug
# builds) also from the crate root. Existing shell environment variables always
# take precedence over values here.

# --- Upstream (required) ---
# Format of the upstream API: anthropic-messages | oai-chat. Never guessed from the URL.
MA_UPSTREAM_TYPE=oai-chat
# Base URL of the API (e.g. https://api.example.com/v1)
MA_UPSTREAM_URL=http://127.0.0.1:18650/v1/chat/completions
# API key
MA_UPSTREAM_API_KEY=sk-1234567890
# Model id (defaults per MA_UPSTREAM_TYPE: deepseek-v4-flash / claude-sonnet-4-5)
MA_UPSTREAM_MODEL=stupid-monkey[1m]

# --- Agent behaviour ---
MA_MAX_TOKENS=1024000
# Max tool-loop iterations before giving up (exit 2).
MA_MAX_TURNS=256
# Comma-separated tool names that must never run (e.g. "bash").
# MA_DENY_TOOLS=
# 0 disables the bash safety gate (pure auto).
MA_GATE=1
# Cap on tool output fed back into context (bytes).
MA_MAX_TOOL_RESULT_BYTES=32768
# JSON object of extra request headers, e.g. {"X-Trace-Id":"abc"}.
# MA_HEADERS=
# Persona that REPLACES the built-in one (string or file path).
# MA_PERSONA=
# System prompt prefix (string or file path).
# MA_SYSTEM_PREFIX=
# System prompt suffix (string or file path; point at a repo guidance file to
# inject project context).
# MA_SYSTEM_SUFFIX=

# --- Reasoning (thinking / effort) ---
# Reasoning intensity: none (no field sent) | low | high (default) | max.
# Mapped per provider: oai-chat -> top-level reasoning_effort (e.g. for DeepSeek
# or OpenAI); anthropic-messages -> an Anthropic thinking block (budget
# auto-clamped below MA_MAX_TOKENS).
MA_THINKING_EFFORT=high

# --- MCP ---
# JSON array of MCP servers: stdio ({name,cmd,args,env}) or SSE ({name,url}).
MA_MCP_SERVERS='[{"name":"tavily","url":"https://mcp.tavily.com/mcp/?tavilyApiKey=<your-api-key>"}]'
# Per-server connect + list_tools timeout (ms).
# MA_MCP_LIST_TOOLS_TIMEOUT_MS=10000

# --- Logging ---
# Directory for per-launch log files (<yyyyMMdd-HHmmss>.log).
MA_LOG_FILE_DIR=./ma-logs
# tracing level for internal/file logging.
MA_LOG_LEVEL=debug
